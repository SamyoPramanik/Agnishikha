# AstraFlame Docker Compose Environment Variables
# Copy this file to .env to customize your configuration:
#   cp .env.example .env

# Host port mapping for the Python ML Prediction API (default: 8000)
API_PORT=8000

# Host port mapping for the Next.js Frontend Dashboard (default: 3000)
UI_PORT=3000

# Browser-accessible URL of the AstraFlame API
# If accessing from another machine on your local network, change localhost to your LAN IP (e.g. http://192.168.1.100:8000)
NEXT_PUBLIC_IGNIS_API_URL=http://localhost:8000

# Allowed CORS origins for the API (default * allows all origins)
IGNIS_ALLOWED_ORIGINS=*

